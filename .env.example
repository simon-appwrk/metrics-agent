# ==========================================
# GRAFANA CONFIGURATION
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_PORT=3000

# ==========================================
# LOKI CONFIGURATION
# ==========================================
LOKI_PORT=3100

# ==========================================
# PROMETHEUS CONFIGURATION (optional, for metrics)
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# REMOTE SERVERS - LOGS SOURCE
# ==========================================
# Add your remote servers here (EC2, VPS, Local machines)
# Format: SERVER_NAME=hostname:port

# Example Remote Server 1 (EC2 Instance)
REMOTE_SERVER_1_NAME=ec2-server-1
REMOTE_SERVER_1_HOST=10.0.1.100
REMOTE_SERVER_1_PORT=9100

# Example Remote Server 2 (VPS)
REMOTE_SERVER_2_NAME=vps-server-2
REMOTE_SERVER_2_HOST=192.168.1.50
REMOTE_SERVER_2_PORT=9100

# Example Remote Server 3 (Local Machine)
REMOTE_SERVER_3_NAME=local-machine-3
REMOTE_SERVER_3_HOST=192.168.1.20
REMOTE_SERVER_3_PORT=9100

# ==========================================
# PM2 LOG PATHS (on remote servers)
# ==========================================
# Path to pm2 logs directory on remote servers
PM2_LOG_PATH=/home/user/.pm2/logs

# ==========================================
# DOCKER LOG PATHS
# ==========================================
# Path to docker logs (usually /var/lib/docker/containers)
DOCKER_LOG_PATH=/var/lib/docker/containers

# ==========================================
# LOKI RETENTION
# ==========================================
# How long to keep logs (in hours)
LOKI_RETENTION_HOURS=168

# ==========================================
# ALERTMANAGER EMAIL NOTIFICATIONS
# ==========================================
# Copy these values into alertmanager/alertmanager.yml after you create .env
# This file shows the fields you will need for email alerts.
ALERTMANAGER_PORT=3093
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alertmanager@example.com
ALERTMANAGER_SMTP_AUTH_USERNAME=smtp-user
ALERTMANAGER_SMTP_AUTH_PASSWORD=smtp-password
ALERTMANAGER_EMAIL_TO=dev-team@example.com
ALERTMANAGER_EMAIL_SEND_RESOLVED=true

# ==========================================
# NODE EXPORTER SCRAPE INTERVAL
# ==========================================
# How often to collect metrics (in seconds)
SCRAPE_INTERVAL=15s

# ==========================================
# KUBERNETES CONFIGURATION (if using K8s)
# ==========================================
NAMESPACE=monitoring
DOMAIN_NAME=localhost
GRAFANA_SERVICE_TYPE=NodePort
GRAFANA_NODE_PORT=30300
LOKI_NODE_PORT=30310
