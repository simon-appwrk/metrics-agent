# ==========================================
# REMOTE MONITORING AGENT — environment file
# ==========================================
# Copy this file to the remote server as:
#   /etc/monitoring-agent/.env  (chmod 600, owned by root)
#
# Then run:
#   sudo ./setup-remote-server.sh
#
# NEVER commit the real .env file. Only this .example template is tracked.

# ------------------------------------------
# Identity of THIS remote server
# ------------------------------------------
# Used as the `server` label in Loki + Prometheus. Defaults to `hostname` if unset.
SERVER_NAME=app-server-1

# ------------------------------------------
# Central monitoring endpoints (HTTPS via Cloudflare Tunnel)
# ------------------------------------------
# Loki push endpoint — Promtail sends logs here.
LOKI_PUSH_URL=https://stream.appwrk.com/loki/api/v1/push

# Prometheus remote_write endpoint — the agent ships metrics here.
# Central Prometheus must be started with --web.enable-remote-write-receiver
# and exposed behind the auth-proxy at metrics.appwrk.com.
PROM_REMOTE_WRITE_URL=https://metrics.appwrk.com/api/v1/write

# Grafana URL (informational only — agents do not call this).
GRAFANA_URL=https://pulse.appwrk.com

# ------------------------------------------
# HTTP Basic Auth credentials
# ------------------------------------------
# These MUST match the credentials created on the central side by:
#   bash scripts/create-auth-secret.sh <AUTH_USERNAME> <AUTH_PASSWORD>
#
# The auth-proxy (nginx) in the cluster enforces these on every request.
# DUMMY VALUES — replace before running the setup script.
AUTH_USERNAME=monitoring
AUTH_PASSWORD=replace-me-with-the-strong-password-from-the-secret

# ------------------------------------------
# Loki tenant (only used if Loki has auth_enabled: true centrally)
# Safe to leave as `production` for the default config in this repo.
# ------------------------------------------
LOKI_TENANT_ID=production

# ------------------------------------------
# Scrape interval for the local node_exporter
# ------------------------------------------
SCRAPE_INTERVAL=15s
